# =============================================================================
# Indra — environment template
#
# Copy to .env and adjust. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# THERE ARE NO API KEYS HERE, and that is the point. Retrieval embeds with a
# local sentence-transformer and advisories are composed by a local model
# under guided decoding, so the service authenticates to nothing. Nothing in
# this file is a secret; it is host paths and ports.
#
# The backend itself reads no environment variables for configuration --
# everything it needs comes from configs/, validated at startup. These
# variables are consumed by docker-compose.yml and by the Vite dev server.
# =============================================================================

# -----------------------------------------------------------------------------
# Ports on the host
# -----------------------------------------------------------------------------
INDRA_BACKEND_PORT=8000
INDRA_FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# Artefact locations on the host
#
# Every one of these is absent from a fresh clone and is mounted into the
# container. The service starts without them and reports each as unavailable
# on /healthz, so you can bring them up one at a time.
#
# Point these at an external drive if your home volume is small: the fusion
# checkpoint and the advisory model together are several gigabytes, and the
# window cache is ~164 GiB at the default target_only scope.
# -----------------------------------------------------------------------------

# Fused relay weights: checkpoints/indra_fusion_v1.pt
INDRA_CHECKPOINTS_DIR=./checkpoints

# Local advisory model, e.g. models/advisory/Qwen2.5-1.5B-Instruct
#   huggingface-cli download Qwen/Qwen2.5-1.5B-Instruct \
#     --local-dir models/advisory/Qwen2.5-1.5B-Instruct
INDRA_MODELS_DIR=./models

# Persisted Chroma collection of NDMA guidance. Survives restarts; rebuilding
# it means re-embedding the whole corpus.
INDRA_VECTORSTORE_DIR=./vectorstore

# Raw and processed geophysical data, and the window cache beneath it.
INDRA_DATA_DIR=./data

# Experience replay manifest. Small, but resuming a training run without it
# resets the reservoir's sampling state.
INDRA_REPLAY_DIR=./replay_buffer

# -----------------------------------------------------------------------------
# Frontend
#
# These are read by the vendored Vite application (see
# frontend/src/services/). They are evaluated in the *browser*, not in the
# container, so the URL must be reachable from your machine --
# http://localhost:8000, never http://backend:8000. The compose service name
# resolves inside the Docker network and means nothing to a browser.
# -----------------------------------------------------------------------------
VITE_ALERTING_API_URL=http://localhost:8000
VITE_ML_MODEL_API_URL=http://localhost:8000

# The frontend ships with mock data and only calls this API when these are
# "true". Leave them false until /healthz reports ready: with no checkpoint
# mounted every forecast request returns 503, and the mocks at least render.
VITE_USE_REAL_ALERTS=false
VITE_USE_REAL_MODEL=false

# -----------------------------------------------------------------------------
# Build
#
# torch defaults to the CPU wheel index, which is roughly 2 GB smaller than the
# CUDA build and is what a laptop demo wants. For a GPU deployment, build with
#   TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
# and set inference.model.device to "cuda" in configs/inference/nowcast.yaml.
# -----------------------------------------------------------------------------
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
